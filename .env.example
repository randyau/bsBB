# ============================================================
# bsBB Forum — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# For production: run `bash scripts/setup.sh` — it fills this automatically.
# For local dev: only DATABASE_URL and SESSION_SECRET are required.
# ============================================================

# ------------------------------------------------------------
# ATproto OAuth (required for production login)
# ------------------------------------------------------------
# The URL where your forum's client-metadata.json is served.
# Must match PUBLIC_BASE_URL below. Generated by setup.sh.
ATPROTO_CLIENT_ID=https://yourforum.com/client-metadata.json

# P-256 JWK private key (JSON string). Generated by scripts/gen-keypair.js
# and written automatically by setup.sh. Do not edit manually.
ATPROTO_PRIVATE_KEY=

# P-256 JWK public key (JSON string). Generated by scripts/gen-keypair.js
# and written automatically by setup.sh. Used by client-metadata.json endpoint.
ATPROTO_PUBLIC_KEY=

# ------------------------------------------------------------
# ATproto Notification Bot Account
# ------------------------------------------------------------
# A Bluesky account that sends DM notifications on behalf of the forum.
# Create an App Password at https://bsky.app/settings/app-passwords
ATPROTO_SERVICE_HANDLE=notifications.yourforum.bsky.social
ATPROTO_SERVICE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------
# SMTP Email (for moderation alerts to admins)
# ------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=
SMTP_FROM=noreply@yourforum.com
ADMIN_EMAIL=admin@yourforum.com

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Dev: points to the local Docker container (default works out of the box)
# Production: set by setup.sh to use the Docker Compose `db` service
DATABASE_URL=postgresql://forum:forum@localhost:5432/forum

# Production only — used by docker-compose.prod.yml to configure the DB container.
# Leave blank for dev (not needed).
DB_USER=forum
DB_PASSWORD=
DB_NAME=forum

# ------------------------------------------------------------
# Sessions
# ------------------------------------------------------------
# Random secret for signing session tokens. At least 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
# The full public URL where the forum is hosted (no trailing slash).
PUBLIC_BASE_URL=https://yourforum.com

# Domain only (no https://), used by Caddy for automatic SSL.
DOMAIN=yourforum.com

# Comma-separated list of allowed Host header values.
# REQUIRED in production — prevents host header injection attacks.
# If unset in production, ALL requests will be rejected with HTTP 400.
# Example: ALLOWED_HOSTS=yourforum.com,www.yourforum.com
ALLOWED_HOSTS=yourforum.com

SETUP_COMPLETE=false

# Default visibility for new forums: "public" or "members-only"
DEFAULT_FORUM_VISIBILITY=public

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Log level for the Pino logger. Valid values: trace, debug, info, warn, error, fatal
# Defaults to 'debug' in development and 'info' in production if unset.
# In development, output is pretty-printed to the terminal.
# In production, output is newline-delimited JSON (compatible with Docker json-file driver).
LOG_LEVEL=info

# ------------------------------------------------------------
# Dev auth bypass — LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------
# Enables the /dev/login page with pre-seeded test users.
# NEVER set this in production — it bypasses real authentication.
# Also requires: npx tsx scripts/seed-dev-users.ts
# DEV_AUTH_ENABLED=true
