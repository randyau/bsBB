# Minimal .env for testing

# ATproto OAuth Client
ATPROTO_CLIENT_ID=https://localhost:5173/client-metadata.json
ATPROTO_PRIVATE_KEY={"crv":"P-256","d":"oFJF6OoPlPm8Z9KLNFk1EKHgCNyZg1TAhNHjw3e7a94","kty":"EC","use":"sig","x":"YzKhAv9p8LZVH0J0RDNlJ8_UyJ8hNvpj7LH93T8I2w4","y":"xVWbTpJRDrqkQxFo31iBhgF2o8kp-D_lqgm2Kq5BrNE"}

# ATproto Service/Notification Account
ATPROTO_SERVICE_HANDLE=dev.test.bsky.social
ATPROTO_SERVICE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# SMTP Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@test.com
SMTP_PASS=test
SMTP_FROM=noreply@test.com
ADMIN_EMAIL=admin@test.com

# Database
DATABASE_URL=postgresql://forum:forum@localhost:5432/forum

# Sessions
SESSION_SECRET=test-session-secret-this-is-a-long-enough-secret-for-testing

# Encryption key for tests (32-byte hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# App
PUBLIC_BASE_URL=http://localhost:5173
SETUP_COMPLETE=true

# Security
ALLOWED_HOSTS=localhost,127.0.0.1

# Dev auth
DEV_AUTH_ENABLED=true
