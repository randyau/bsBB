{
	"name": "bsbb",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:setup": "bash scripts/dev.sh",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bash scripts/migrate.sh",
		"docker:build": "bash scripts/docker-rebuild.sh",
		"docker:restart": "bash scripts/docker-restart.sh",
		"docker:stop": "bash scripts/docker-stop.sh",
		"db:stamp": "npx tsx scripts/stamp-migrations.ts"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/dompurify": "^3.0.5",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.8.0",
		"@types/nodemailer": "^8.0.0",
		"@vitest/coverage-v8": "^4.1.6",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@atproto/api": "^0.19.18",
		"@atproto/oauth-client-node": "^0.3.17",
		"@sveltejs/adapter-node": "^5.5.4",
		"dompurify": "^3.4.3",
		"drizzle-orm": "^0.45.2",
		"markdown-it": "^14.1.1",
		"node-emoji": "^2.2.0",
		"nodemailer": "^6.9.7",
		"open-graph-scraper": "^6.11.0",
		"postgres": "^3.4.9",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"rolldown": "^1.0.1",
		"unified": "^11.0.5"
