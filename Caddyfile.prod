{$DOMAIN} {
	handle /client-metadata.json {
		root * /srv/static
		file_server
	}

	handle /assets/* {
		root * /app/uploads
		file_server
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		# CSP is set by SvelteKit (svelte.config.js) with per-request nonces — do not set here.
		# X-Frame-Options is set by hooks.server.ts as DENY — do not override here.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
